import {getStore,getDeployStore} from '@netlify/blobs';
import {randomBytes,scrypt as scryptCallback,timingSafeEqual,createHash} from 'node:crypto';
import {promisify} from 'node:util';
import {Problem} from './project.mjs';
const scrypt=promisify(scryptCallback);
export const FLOOR_ZONES:Record<string,string[]>={b1:['b1'],'1':['1'],'2':['2a','2b'],'3':['3'],'4':['4'],'5':['5']};
export function accessStore(){const o={name:'arirang-floor-access',consistency:'strong' as const};return Netlify.env.get('CONTEXT')==='production'?getStore(o):getDeployStore(o)}
export const tokenHash=(s:string)=>createHash('sha256').update(s).digest('hex');
export function sessionToken(req:Request){return req.headers.get('cookie')?.match(/(?:^|;\s*)__Host-arirang_floor=([a-f0-9]{64})(?:;|$)/)?.[1]||''}
export const floorCookie=(token:string,maxAge=28800)=>`__Host-arirang_floor=${token}; Path=/; HttpOnly; Secure; SameSite=Strict; Max-Age=${maxAge}`;
export async function identityAdmin(req:Request){const jwt=req.headers.get('cookie')?.match(/(?:^|;\s*)nf_jwt=([^;]+)/)?.[1],origin=Netlify.env.get('URL');if(!jwt||!origin)return '';try{const r=await fetch(origin+'/.netlify/identity/user',{headers:{Authorization:'Bearer '+decodeURIComponent(jwt)},signal:AbortSignal.timeout(8000)});if(!r.ok)return '';const user=await r.json();return user.app_metadata?.roles?.includes('admin')?String(user.id):''}catch{return ''}}
export async function floorSession(req:Request){const token=sessionToken(req);if(!token)return null;const store=accessStore(),row=await store.getWithMetadata('sessions/'+tokenHash(token),{type:'json'});if(!row||row.data.expires<=Date.now()||!FLOOR_ZONES[row.data.floor])return null;const config=await store.getWithMetadata('credentials/'+row.data.floor,{type:'json'});if(!config?.data.active||config.data.version!==row.data.version)return null;return {actor:'floor:'+row.data.floor,floor:row.data.floor,zones:FLOOR_ZONES[row.data.floor]};}
export async function setFloorPassword(floor:string,password:unknown,actor:string,active=true){if(!FLOOR_ZONES[floor]||typeof password!=='string'||password.length<12||password.length>128)throw new Problem('층과 12~128자 비밀번호를 확인하세요.');const salt=randomBytes(16).toString('hex'),hash=(await scrypt(password,salt,64) as Buffer).toString('hex');await accessStore().setJSON('credentials/'+floor,{salt,hash,version:crypto.randomUUID(),active,actor,updated:new Date().toISOString()});}
export async function passwordLogin(floor:string,password:unknown){if(!FLOOR_ZONES[floor]||typeof password!=='string'||password.length>128)throw new Problem('층과 비밀번호를 확인하세요.',401);const store=accessStore(),row=await store.getWithMetadata('credentials/'+floor,{type:'json'}),salt=row?.data.salt||'00000000000000000000000000000000';const computed=await scrypt(password,salt,64) as Buffer;const expected=Buffer.from(row?.data.hash||'00'.repeat(64),'hex');if(!row?.data.active||expected.length!==computed.length||!timingSafeEqual(expected,computed))throw new Problem('비밀번호가 일치하지 않거나 사용 준비 전입니다.',401);const token=randomBytes(32).toString('hex');await store.setJSON('sessions/'+tokenHash(token),{floor,version:row.data.version,expires:Date.now()+28800000},{onlyIfNew:true});return token;}
export function assertFloor(zones:string[]|null,id:string){if(zones&&!zones.includes(id))throw new Problem('담당 층의 자료만 이용할 수 있습니다.',403)}
