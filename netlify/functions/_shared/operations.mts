import {Problem} from './project.mjs';
export type OpsEntry={id:string,kind:'office'|'accounting'|'benefit'|'inventory',at:string,actor:string,[key:string]:any};
export type OpsState={version:number,entries:OpsEntry[]};
export const emptyOps=():OpsState=>({version:0,entries:[]});
const string=(v:unknown,max=100,required=true)=>{if(typeof v!=='string'||v.length>max||(required&&!v.trim()))throw new Problem('필수 문구와 길이를 확인하세요.');return v.trim()};
const number=(v:unknown,min=0,max=100000000000)=>{if(typeof v!=='number'||!Number.isFinite(v)||v<min||v>max)throw new Problem('숫자 범위를 확인하세요.');return v};
const integer=(v:unknown,min=0,max=100000000000)=>{const n=number(v,min,max);if(!Number.isSafeInteger(n))throw new Problem('정수를 입력하세요.');return n};
const oneOf=(v:unknown,allowed:string[])=>{if(typeof v!=='string'||!allowed.includes(v))throw new Problem('선택 값을 확인하세요.');return v};
function isoDate(v:unknown){const s=string(v,10);if(!/^\d{4}-\d{2}-\d{2}$/.test(s)||!Number.isFinite(Date.parse(s))||new Date(s).toISOString().slice(0,10)!==s)throw new Problem('날짜를 확인하세요.');return s}
export function stockRows(entries:OpsEntry[]){const stock=new Map<string,any>();for(const e of entries.filter(e=>e.kind==='inventory')){const key=e.code+'|'+e.lot;const r=stock.get(key)||{code:e.code,name:e.name,lot:e.lot,unit:e.unit,expiry:e.expiry,quantityMilli:0,reorder:e.reorder,category:e.category};r.quantityMilli+=(e.direction==='in'?1:-1)*Math.round(e.quantity*1000);r.reorder=e.reorder;stock.set(key,r);}return [...stock.values()].map(r=>({...r,quantity:r.quantityMilli/1000}));}
export function addEntry(state:OpsState,input:any,actor:string,floor:string):OpsState{
 if(!input||input.version!==state.version)throw new Problem('다른 관리자가 수정했습니다. 다시 불러오세요.',409);if(state.entries.length>=10000)throw new Problem('기록 보관 한도입니다. 담당자에게 이관을 요청하세요.',409);
 const kind=oneOf(input.kind,['office','accounting','benefit','inventory']) as OpsEntry['kind'];const e:OpsEntry={id:crypto.randomUUID(),kind,at:new Date().toISOString(),actor,date:isoDate(input.date)};
 if(kind==='office'){Object.assign(e,{title:string(input.title,150),owner:string(input.owner,60,false),due:input.due?isoDate(input.due):'',status:oneOf(input.status,['예정','진행','완료']),note:string(input.note,1000,false)});}
 if(kind==='accounting'){Object.assign(e,{direction:oneOf(input.direction,['income','expense']),category:string(input.category,60),amount:integer(input.amount,1),evidence:string(input.evidence,200),note:string(input.note,500,false),reviewStatus:'기록·증빙 대조 전'});}
 if(kind==='benefit'){if(floor!=='3')throw new Problem('해온 전용 업무입니다.',403);const residentRef=string(input.residentRef,30);if(!/^[A-Za-z0-9_-]{1,30}$/.test(residentRef))throw new Problem('입소자 코드는 영문·숫자·_-로 입력하세요.');const month=string(input.month,7);if(!/^\d{4}-(0[1-9]|1[0-2])$/.test(month))throw new Problem('대상 월을 확인하세요.');if(state.entries.some(r=>r.kind==='benefit'&&r.month===month&&r.residentRef===residentRef))throw new Problem('같은 입소자·월의 산출 기록이 이미 있습니다.',409);if(state.entries.filter(r=>r.kind==='benefit'&&r.month===month).length>=49)throw new Problem('월별 계획 정원 49명을 초과했습니다.');const maxDays=new Date(Number(month.slice(0,4)),Number(month.slice(5)),0).getDate(),days=integer(input.days,1,maxDays),dailyFee=integer(input.dailyFee,1,10000000),copayPercent=number(input.copayPercent,0,100),extras=integer(input.extras,0,100000000);const gross=days*dailyFee,copay=Math.round(gross*copayPercent/100);Object.assign(e,{residentRef,month,days,dailyFee,copayPercent,extras,rateEvidence:string(input.rateEvidence,300),gross,copay,insurer:gross-copay,residentTotal:copay+extras,reviewStatus:'수기 요율 산출 초안 · 공단 미제출'});}
 if(kind==='inventory'){const code=string(input.code,40),lot=string(input.lot,60);if(!/^[A-Za-z0-9_-]+$/.test(code)||code.includes('|')||lot.includes('|'))throw new Problem('품목 코드는 영문·숫자·_-만 사용하고 로트에는 |를 제외하세요.');const quantity=number(input.quantity,.001,1000000);if(Math.abs(quantity*1000-Math.round(quantity*1000))>1e-6)throw new Problem('수량은 소수 셋째 자리까지 입력하세요.');const unit=string(input.unit,15),category=oneOf(input.category,['식자재','기타 재고']),expiry=input.expiry?isoDate(input.expiry):'';const existing=state.entries.filter(r=>r.kind==='inventory'&&r.code===code);if(existing.some(r=>r.unit!==unit||r.category!==category))throw new Problem('같은 품목의 단위·구분을 유지하세요.');if(existing.some(r=>r.lot===lot&&r.expiry!==expiry))throw new Problem('동일 로트의 소비기한을 유지하세요.');Object.assign(e,{code,lot,name:string(input.name,100),quantity,unit,category,expiry,reorder:number(input.reorder,0,1000000),direction:oneOf(input.direction,['in','out']),note:string(input.note,500,false)});const balance=stockRows([...state.entries,e]).find(r=>r.code===code&&r.lot===lot);if(balance.quantityMilli<0)throw new Problem('해당 로트 재고보다 많이 출고할 수 없습니다.',409);}
 return {version:state.version+1,entries:[...state.entries,e]};
}
export function operationsSummary(state:OpsState){const today=new Date().toISOString().slice(0,10),stock=stockRows(state.entries),accounts=state.entries.filter(e=>e.kind==='accounting'),benefits=state.entries.filter(e=>e.kind==='benefit');return {version:state.version,totalRecords:state.entries.length,office:{open:state.entries.filter(e=>e.kind==='office'&&e.status!=='완료').length},accounting:{income:accounts.filter(e=>e.direction==='income').reduce((a,e)=>a+e.amount,0),expense:accounts.filter(e=>e.direction==='expense').reduce((a,e)=>a+e.amount,0)},benefits:{drafts:benefits.length,gross:benefits.reduce((a,e)=>a+e.gross,0),submitted:0},inventory:{lots:stock.length,lowStock:stock.filter(r=>r.quantity<=r.reorder).length,expired:stock.filter(r=>r.quantity>0&&r.expiry&&r.expiry<today).length},limitations:['수기 요율·증빙 대조 필요','세무 신고·공단 청구 자동 제출 없음']};}
