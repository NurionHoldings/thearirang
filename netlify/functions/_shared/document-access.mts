import {randomBytes,scrypt as callback,timingSafeEqual} from 'node:crypto';import {promisify} from 'node:util';
import {accessStore,tokenHash} from './floor-access.mjs';import {Problem} from './project.mjs';
const scrypt=promisify(callback),cookieName='__Host-arirang_documents';
export const documentCookie=(token:string,maxAge=28800)=>`${cookieName}=${token}; Path=/; HttpOnly; Secure; SameSite=Strict; Max-Age=${maxAge}`;
const tokenOf=(req:Request)=>req.headers.get('cookie')?.match(/(?:^|;\s*)__Host-arirang_documents=([a-f0-9]{64})(?:;|$)/)?.[1]||'';
async function credential(){const password=Netlify.env.get('ARIRANG_DOCUMENT_PASSWORD')?.trim();if(!password||password.length<9||password.length>128)return null;const hash=await scrypt(password,'arirang-document-uploader-v1',64) as Buffer;return {hash,version:tokenHash(hash.toString('hex'))};}
export async function documentLogin(password:unknown){if(typeof password!=='string'||password.length>128)throw new Problem('비밀번호를 확인하세요.',401);const configured=await credential();if(!configured)throw new Problem('Netlify에 ARIRANG_DOCUMENT_PASSWORD를 9~128자로 설정하고 재배포하세요.',503);const computed=await scrypt(password.trim(),'arirang-document-uploader-v1',64) as Buffer;if(!timingSafeEqual(computed,configured.hash))throw new Problem('자료등록 전용 비밀번호가 일치하지 않습니다.',401);const token=randomBytes(32).toString('hex');await accessStore().setJSON('document-sessions/'+tokenHash(token),{actor:'document-uploader',version:configured.version,expires:Date.now()+28800000},{onlyIfNew:true});return token;}
export async function documentSession(req:Request){const token=tokenOf(req);if(!token)return null;const row=await accessStore().getWithMetadata('document-sessions/'+tokenHash(token),{type:'json'});if(!row||row.data.expires<=Date.now())return null;const configured=await credential();return configured&&row.data.version===configured.version?{actor:'document-uploader'}:null;}
export async function documentLogout(req:Request){const token=tokenOf(req);if(token)await accessStore().delete('document-sessions/'+tokenHash(token));}
