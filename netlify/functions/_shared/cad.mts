import {Problem,text} from './project.mjs';
export function validateCAD(v:any){if(!v||v.unit!=='mm'||!Number.isFinite(v.width)||v.width<1000||v.width>200000||!Number.isFinite(v.height)||v.height<1000||v.height>200000||!Array.isArray(v.elements)||v.elements.length>500)throw new Problem('도면 크기·요소 수를 확인하세요.');const ids=new Set();const elements=v.elements.map((e:any)=>{if(!e||!['wall','line','door','window','rect','column','furniture','text','dimension'].includes(e.type)||typeof e.id!=='string'||!/^e-[a-z0-9-]{1,60}$/.test(e.id)||ids.has(e.id))throw new Problem('도면 요소 형식 오류');ids.add(e.id);const out:any={id:e.id,type:e.type,label:text(e.label??'',100,'도면 이름')};for(const k of ['x','y','x2','y2','w','h']){const n=e[k]??0;if(typeof n!=='number'||!Number.isFinite(n)||Math.abs(n)>200000)throw new Problem('좌표·치수 범위 오류');out[k]=n;}if(['rect','column','furniture'].includes(e.type)&&(out.w<=0||out.h<=0))throw new Problem('폭·높이는 양수로 입력하세요.');return out});return {unit:'mm',width:v.width,height:v.height,verified:v.verified===true,title:text(v.title??'',100,'도면 제목'),elements,updated:new Date().toISOString()}}
