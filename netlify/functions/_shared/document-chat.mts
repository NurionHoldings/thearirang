import type {Project} from './project.mjs';import type {ChatMessage} from './operations-chat.mjs';
export function documentSummary(project:Project){const kinds={designs:'design',quotes:'quote',contracts:'contract'} as const;const byKind={design:0,quote:0,contract:0},byZone:Record<string,number>={};let total=0;for(const [zone,data]of Object.entries(project.zones)){byZone[zone]=0;for(const [field,kind]of Object.entries(kinds))for(const item of (data as any)[field]||[])if(item.submittedBy==='document-uploader'){byKind[kind]++;byZone[zone]++;total++}}return {total,byKind,byZone}}
export function guidedDocumentChat(messages:ChatMessage[],summary:ReturnType<typeof documentSummary>){const q=messages.at(-1)!.content,context=messages.filter(m=>m.role==='user').map(m=>m.content).join(' ');if(/몇|건수|현황|집계|목록/.test(q))return `이 자료등록 계정의 누적 등록은 총 ${summary.total}건입니다. 설계자료 ${summary.byKind.design}건, 견적서 ${summary.byKind.quote}건, 계약서 ${summary.byKind.contract}건입니다.\n어느 층 또는 자료 종류의 등록 절차를 도와드릴까요?`;
if(/비번|비밀번호|로그인/.test(q))return '자료등록 전용 비밀번호는 Netlify의 ARIRANG_DOCUMENT_PASSWORD에서 설정합니다. Functions·Production에 적용하고 재배포하세요. 비밀번호를 채팅에 입력하지 마세요. 층별 업무 로그인과는 별도 계정입니다.';
if(/분석|검토|원문|읽어/.test(q))return '이 채팅은 업로드한 파일 원문을 읽거나 자동 분석하지 않습니다. 파일은 총괄·해당 층 관리자가 별도로 검토합니다. 개인정보를 제외한 질문을 입력하시면 등록 절차와 분류를 안내할 수 있습니다. 어떤 부분이 궁금하신가요?';
if(/계약/.test(context))return '계약서는 자료 구분에서 ‘계약서’를 선택하세요. 세부 종류에는 공사·납품·용역 등 계약 유형을 적고 대상 층·업체·공종을 지정합니다. PDF 또는 JPG·PNG·WebP를 파일당 3MB 이하, 한 번에 최대 6개까지 등록합니다. 계약 체결·법률 적합성 확인은 별도입니다.\n어느 층의 어떤 계약을 등록하시나요?';
if(/견적/.test(context))return '견적서는 자료 구분에서 ‘견적서’를 선택한 뒤 대상 층·업체·공종을 입력하세요. 업체별로 나누어 PDF 또는 이미지로 등록하면 담당 관리자가 견적·계약 자료를 연결해 검토하기 쉽습니다.\n어느 층, 어떤 공종의 견적서인가요?';
if(/설계|도면/.test(context))return '설계자료는 대상 층과 ‘설계자료·도면’을 선택하고 세부 종류에 건축·인테리어·전기 등 구분을 입력하세요. CAD·엑셀·문서 파일은 PDF로 변환해 등록합니다. 자료는 비공개이며 해당 층·총괄관리자가 검토합니다.\n어떤 설계자료를 등록하시나요?';
return '자료등록 순서는 대상 층 선택 → 설계자료·견적서·계약서 구분 → 업체·공종 입력 → 파일 등록입니다. PDF·JPG·PNG·WebP, 파일당 3MB 이하·한 번에 최대 6개를 지원합니다.\n어떤 자료를 등록하시려나요? 현재는 업무 안내 모드이며 자유 대화는 서버 AI 연결 후 제공됩니다.';}
