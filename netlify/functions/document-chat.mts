import type {Config} from '@netlify/functions';import {getStore,getDeployStore} from '@netlify/blobs';import {documentSession} from './_shared/document-access.mjs';import {chatMessages} from './_shared/operations-chat.mjs';import {documentSummary,guidedDocumentChat} from './_shared/document-chat.mjs';import {initial,Problem} from './_shared/project.mjs';import {consultEthernion} from './_shared/arkaon-consult.mjs';import {aiReady} from './_shared/ai.mjs';
const headers={'Cache-Control':'private, no-store','X-Content-Type-Options':'nosniff'};
export default async function handler(req:Request){try{
 const session=await documentSession(req);if(!session)throw new Problem('자료등록 전용 비밀번호로 다시 로그인하세요.',401);
