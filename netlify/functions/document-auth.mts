import type {Config} from '@netlify/functions';import {documentCookie,documentLogin,documentLogout,documentSession} from './_shared/document-access.mjs';import {Problem} from './_shared/project.mjs';
const json=(v:unknown,status=200,cookie?:string)=>new Response(JSON.stringify(v),{status,headers:{'Content-Type':'application/json','Cache-Control':'private, no-store','X-Content-Type-Options':'nosniff',...(cookie?{'Set-Cookie':cookie}:{})}});
export default async function handler(req:Request){try{const u=new URL(req.url);if(req.method!=='GET'&&req.headers.get('origin')!==u.origin)throw new Problem('요청 출처 오류',403);if(req.method==='GET'&&u.pathname==='/document-auth/session')return json({loggedIn:!!await documentSession(req),role:'document-uploader'});if(req.method!=='POST')throw new Problem('요청 없음',404);if(u.pathname==='/document-auth/logout'){await documentLogout(req);return json({ok:true},200,documentCookie('',0));}if(u.pathname==='/document-auth/login'){const raw=await req.text();if(raw.length>1000)throw new Problem('입력이 너무 깁니다.',413);const {password}=JSON.parse(raw),token=await documentLogin(password);return json({ok:true},200,documentCookie(token));}throw new Problem('요청 없음',404);}catch(e){return json({error:e instanceof Problem?e.message:'요청을 처리하지 못했습니다.'},e instanceof Problem?e.status:400)}}
export const config:Config={path:'/document-auth/*',rateLimit:{windowLimit:20,windowSize:60,aggregateBy:['ip','domain'],action:'rate_limit'}};
